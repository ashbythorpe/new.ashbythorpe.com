[Unit]
Description=Go API Backend
Requires=restore.container
After=restore.container
Wants=litestream.container
After=litestream.container

[Container]
ContainerName=web
Image=localhost/ashbythorpe-backend:latest
Pod=web.pod

Volume=/mnt/sqlite-data:/data:Z

HealthCmd=/usr/local/bin/run-app healthcheck
HealthOnFailure=kill
Notify=healthy

Environment=ORIGIN=https://new.ashbythorpe.com
Environment=DB_PATH=/data/app.db
Environment=SMTP_HOST=smtp.email.uk-london-1.oci.oraclecloud.com
Environment=SMTP_PORT=587

Secret=otp-pepper,type=env,target=PEPPER
Secret=github-client-id,type=env,target=GITHUB_CLIENT_ID
Secret=github-client-secret,type=env,target=GITHUB_CLIENT_SECRET
Secret=turnstile-secret-key,type=env,target=TURNSTILE_SECRET_KEY
Secret=turnstile-invisible-secret-key,type=env,target=TURNSTILE_INVISIBLE_SECRET_KEY
Secret=smtp-username,type=env,target=SMTP_USERNAME
Secret=smtp-password,type=env,target=SMTP_PASSWORD

[Service]
Restart=always
TimeoutStartSec=900
