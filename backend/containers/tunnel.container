[Unit]
Description=Cloudflare Tunnel
After=web.service
Requires=web.service

[Container]
ContainerName=tunnel
Image=docker.io/cloudflare/cloudflared:latest
Pod=web.pod
AutoUpdate=registry

Secret=cloudflare-tunnel-token
Environment=TUNNEL_TOKEN_FILE=/run/secrets/cloudflare-tunnel-token

Exec=tunnel run

[Service]
Restart=always
